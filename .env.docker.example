# Generate distinct random values for each password and JWT_SECRET_KEY.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
MYSQL_DATABASE=document_management
MYSQL_USER=document_management
MYSQL_PASSWORD=replace-with-a-random-hex-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-hex-password
JWT_SECRET_KEY=replace-with-a-random-hex-secret-at-least-32-bytes
CACHE_TTL_SECONDS=60
LOGIN_RATE_LIMIT_COUNT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
